# Эти переменные задаются в Vercel: Project → Settings → Environment Variables

# Ключ Claude API для оценки эдитов (без него сайт только скачивает видео)
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно: код доступа к оценке, чтобы чужие люди не тратили твой баланс
# ACCESS_CODE=придумай-код

# Необязательно: содержимое cookies.txt для Instagram / YouTube
# COOKIES_TXT=

# Необязательно
# CLAUDE_MODEL=claude-opus-5-5
# MAX_DOWNLOAD_MB=200
# MAX_MINUTES=10
